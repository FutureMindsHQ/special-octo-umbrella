# Supabase — из Project Settings → API на supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI — из platform.openai.com → API Keys
# ВАЖНО: без префикса NEXT_PUBLIC_, чтобы ключ никогда не попал в браузер
OPENAI_API_KEY=sk-your-key-here

# Если ключ ещё не готов — API-роуты автоматически работают в Demo AI Mode
DEMO_AI_MODE=true
